# KLIQ API server environment — copy to .env and fill in real values.

# ── Database (Supabase Postgres via pgbouncer transaction pooler) ──────────
# IMPORTANT: connection_limit must be > 1. With connection_limit=1 every
# Prisma query in the whole server is serialized through a single pooled
# connection; concurrent screens (Reels/Explore feeds run multi-query
# Promise.all) queue up, hit the 20s pool timeout (Prisma P2024) and surface
# in the app as "connection errored" / 500s. 10 is a safe value for the
# Supabase transaction pooler.
DATABASE_URL="postgresql://<user>:<password>@<project>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&connect_timeout=15&pool_timeout=20"
# Direct (non-pooled) connection — used by Prisma migrate/db push.
DIRECT_URL="postgresql://<user>:<password>@<project>.pooler.supabase.com:5432/postgres"

JWT_SECRET="<random-secret>"
PORT=4000

# ── Email (SMTP for password reset / verification) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<gmail-address>
SMTP_PASS=<gmail-app-password>
EMAIL_FROM="KLIQ <no-reply@kliq.app>"
APP_URL=http://localhost:5173

# ── Firebase Admin (push notifications) ────────────────────────────────────
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<service-account-email>

# ── Supabase Storage (media uploads) ───────────────────────────────────────
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_STORAGE_BUCKET="media"
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Google sign-in (Web OAuth client ID) ───────────────────────────────────
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"

# ── Cloudflare R2 (optional media storage) ─────────────────────────────────
CF_R2_ACCOUNT_ID=
CF_R2_BUCKET=kliq-media
CF_R2_PUBLIC_URL=

# ── Agora (voice/video calls — POST /agora/rtc-token, POST /calls) ────────
# Sign up at https://console.agora.io, create a project, and copy its App ID
# + App Certificate (Console > Project Management > your project > Edit,
# enable "App Certificate" if it isn't already). Both are REQUIRED — until
# real values are set, /agora/rtc-token (and therefore /calls) returns a
# clear 503 "Agora not configured" instead of crashing.
AGORA_APP_ID=<agora-app-id>
AGORA_APP_CERTIFICATE=<agora-app-certificate>
