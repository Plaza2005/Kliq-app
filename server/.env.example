# KLIQ API server environment — copy to .env and fill in real values.

# ── Database (Supabase Postgres via pgbouncer transaction pooler) ──────────
# IMPORTANT: connection_limit must be > 1. With connection_limit=1 every
# Prisma query in the whole server is serialized through a single pooled
# connection; concurrent screens (Reels/Explore feeds run multi-query
# Promise.all) queue up, hit the 20s pool timeout (Prisma P2024) and surface
# in the app as "connection errored" / 500s. 10 is a safe value for the
# Supabase transaction pooler.
DATABASE_URL=postgresql://postgres.rrkfhfddwpaqwbfcqhtu:Plazaisthebest2005!@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Direct (non-pooled) connection — used by Prisma migrate/db push.
DIRECT_URL=postgresql://postgres:Plazaisthebest2005!@db.rrkfhfddwpaqwbfcqhtu.supabase.co:5432/postgres

JWT_SECRET=Cie2dl2UZPcA/EkNHUA5Gq6wMcCt1NJ5i9BWsEJ7HY0=

PORT=4000

# ── API & WebSocket Server URLs ────────────────────────────────────────────
API_URL=https://api.kliq.qd.je
WS_URL=wss://api.kliq.qd.je/ws

# ── Email (SMTP for password reset / verification) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
